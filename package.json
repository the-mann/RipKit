{
  "name": "rip-kit",
  "version": "2.0.0",
  "description": "Turn a playlist CSV into tagged MP3s with album art.",
  "license": "MIT",
  "author": "drewjordan414",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewjordan414/RipKit.git"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:build": "npm run build && npm run desktop:prepare && electron-builder --publish never",
    "dev": "vite",
    "build": "vite build",
    "server": "node server.js",
    "start": "npm run build && node server.js",
    "test": "node test-playlists.js && node test-single.js && node test-overrides.js && node test-bandcamp.js && node test-formats.js && node test-job.js"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "archiver": "^7.0.1",
    "csv-parser": "^3.2.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "youtube-dl-exec": "^3.0.27",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
